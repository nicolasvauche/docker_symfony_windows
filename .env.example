HTTP_PORT=8000

# Versions used only when creating a new project (dev.ps1 init).
# Use stable or an exact X.Y.Z version; missing variables default to stable.
PHP_VERSION=stable
FRANKENPHP_VERSION=stable
SYMFONY_VERSION=stable
COMPOSER_VERSION=stable
# Examples: replace the values above to pin your toolchain.
# PHP_VERSION=8.5.12
# FRANKENPHP_VERSION=1.13.5
# SYMFONY_VERSION=8.1.11
# COMPOSER_VERSION=2.11.2

# Optional: unique Compose project name. By default, the folder name is used.
# COMPOSE_PROJECT_NAME=my-symfony-project
# Optional override. SQLite works without a database service.
# DATABASE_URL=postgresql://user:password@host.docker.internal:5432/app?serverVersion=16&charset=utf8
